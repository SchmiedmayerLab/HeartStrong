{
  "name": "heartstrong",
  "version": "1.0.0",
  "description": "Stanford HeartStrong patient education website",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SchmiedmayerLab/HeartStrong"
  },
  "keywords": [
    "Stanford",
    "HeartStrong",
    "Heart Failure",
    "Astro"
  ],
  "engines": {
    "node": "^24.22.3 || >=26.3.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.21.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm run lint:md",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint --format json --output-file eslint_report.json .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run format:check && npm run lint && npm run test:coverage && npm run check && npm run build && npm run test:md-links && npm run test:site && npm run test:toolchain && npm run bundle:public && npm run bundle:audit",
    "test:toolchain": "node scripts/check-toolchain.mjs",
    "bundle:public": "node scripts/build-public-bundle.mjs",
    "bundle:audit": "node scripts/build-public-bundle.mjs --audit",
    "preview:test": "node scripts/serve-built-site.mjs",
    "test:site": "node scripts/audit-built-site.mjs",
    "test:e2e": "playwright test",
    "test:md-links": "node scripts/audit-markdown-links.mjs",
    "lint:md": "markdownlint-cli2",
    "test:portability": "SITE_PORTABILITY_CHECK=1 SITE_URL=https://example.github.io SITE_BASE=/website npm run build && SITE_PORTABILITY_CHECK=1 SITE_URL=https://example.github.io SITE_BASE=/website npm run test:site && SITE_URL=https://example.github.io SITE_BASE=/website npm run bundle:public && SITE_URL=https://example.github.io SITE_BASE=/website npm run bundle:audit && SITE_OUTPUT_DIR=_site SITE_PORTABILITY_CHECK=1 SITE_URL=https://example.github.io SITE_BASE=/website npm run test:e2e -- --project=desktop-chromium",
    "validate:all": "npm run validate && SITE_OUTPUT_DIR=_site npm run test:e2e && npm run test:portability"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "@schmiedmayerlab/grove-configurations": "^0.1.2",
    "@typescript-eslint/parser": "^8.72.1",
    "typescript-eslint": "^8.72.1",
    "@playwright/test": "^1.65.0",
    "@axe-core/playwright": "^4.14.0",
    "parse5": "^8.1.0",
    "markdown-it": "^15.0.3",
    "github-slugger": "^2.0.0",
    "markdownlint-cli2": "^0.24.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "smol-toml@<=1.8.0": "1.9.1",
    "colord@<2.9.4": "2.9.4",
    "svgo@>=4.0.0 <4.1.0": "4.1.0",
    "nanoid": "3.3.20",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "katex@>=0.11.0 <0.18.2": "0.19.1",
    "re2js@>=2.2.0 <2.8.7": "2.9.1",
    "table": {
      "ajv": "8.18.0"
    },
    "yaml-language-server": {
      "ajv": "8.18.0"
    }
  }
}
